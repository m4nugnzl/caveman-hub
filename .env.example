# Copia este archivo a .env y rellena con los valores de tu proyecto Supabase.
# Supabase Dashboard → Settings → API
#
# La anon key es segura de exponer en el cliente: toda la autorización real
# vive en las políticas de Row Level Security de la base de datos.
# NUNCA pongas aquí la service_role key.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui