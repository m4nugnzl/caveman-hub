{
  "name": "caveman-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "verify": "node scripts/verify-styles.mjs",
    "backup": "node --env-file-if-exists=.env --env-file-if-exists=.env.backup scripts/backup.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run types && npm run verify && npm run test && npm run build",
    "types": "tsc --noEmit -p jsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.14.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
